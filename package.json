{
  "name": "sop-app",
  "version": "0.1.0",
  "private": true,
  "description": "SOP_APP — sistema de apoio ao ciclo de S&OP",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:contract": "pnpm --filter @sop/contracts test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
