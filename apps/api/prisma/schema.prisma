// SOP_APP — modelo de dados
// Ver: specs/001-sop-cycle-forecasting/data-model.md
//
// Somente a camada Node acessa este schema. O motor Python não o conhece
// (Princípio III da constituição).
//
// Precisão numérica (Princípio V): quantidade e previsão em Decimal(18,6);
// percentual e métrica em Decimal(12,6). Nunca Float.

generator client {
  provider = "prisma-client-js"
  // linux-musl-openssl-3.0.x é obrigatório para a imagem Alpine: sem ele o
  // contêiner sobe e falha na primeira query.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Identidade e acesso — gerenciado por BetterAuth
// ============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  emailVerifiedAt DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  sessions             Session[]
  accounts             Account[]
  createdScenarios     Scenario[]               @relation("ScenarioCreator")
  memberships          ScenarioMember[]
  uploads              IngestionJob[]
  forecastRequests     ForecastJob[]
  adjustments          CollaborationAdjustment[]
  consensusDecisions   ConsensusDecision[]
  auditEvents          AuditEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  accountId            String
  providerId           String
  password             String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime? @db.Timestamptz
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

// ============================================================================
// Cenário e equipe
// ============================================================================

enum ScenarioPhase {
  TEAM_SETUP
  IMPORT_SETUP
  CALCULATION
  APPROVAL
  COLLABORATION
  CONSENSUS
  PUBLICATION
  ACCURACY
}

enum FinalSayRole {
  CREATOR
  APPROVER
}

enum MemberRole {
  CREATOR
  APPROVER
  COLLABORATOR
}

enum ToleranceKind {
  ABSOLUTE
  PERCENT
}

model Scenario {
  id                      String         @id @default(uuid()) @db.Uuid
  name                    String
  phase                   ScenarioPhase  @default(TEAM_SETUP)
  createdById             String         @db.Uuid
  finalSayRole            FinalSayRole   @default(CREATOR)
  teamClosedAt            DateTime?      @db.Timestamptz
  forecastHorizonMonths   Int            @default(12)
  consensusToleranceValue Decimal?       @db.Decimal(12, 6)
  consensusToleranceKind  ToleranceKind?
  publishedAt             DateTime?      @db.Timestamptz
  createdAt               DateTime       @default(now()) @db.Timestamptz
  updatedAt               DateTime       @updatedAt @db.Timestamptz

  createdBy          User                @relation("ScenarioCreator", fields: [createdById], references: [id])
  members            ScenarioMember[]
  levels             SegmentationLevel[]
  ingestionJobs      IngestionJob[]
  salesRecords       SalesRecord[]
  actualSalesRecords ActualSalesRecord[]
  parameters         ForecastParameters?
  forecastJobs       ForecastJob[]
  adjustments        CollaborationAdjustment[]
  publishedForecasts PublishedForecast[]
  accuracyRuns       AccuracyRun[]
  auditEvents        AuditEvent[]
  notifications      EmailNotification[]

  @@index([createdById])
  @@index([phase])
  @@map("scenarios")
}

model ScenarioMember {
  id                  String     @id @default(uuid()) @db.Uuid
  scenarioId          String     @db.Uuid
  userId              String?    @db.Uuid
  invitedEmail        String
  role                MemberRole
  collaborationDoneAt DateTime?  @db.Timestamptz
  createdAt           DateTime   @default(now()) @db.Timestamptz

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([scenarioId, invitedEmail, role])
  @@index([userId])
  @@map("scenario_members")
}

model SegmentationLevel {
  id         String @id @default(uuid()) @db.Uuid
  scenarioId String @db.Uuid
  position   Int
  label      String

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, position])
  @@unique([scenarioId, label])
  @@map("segmentation_levels")
}

// ============================================================================
// Ingestão
// ============================================================================

enum IngestionKind {
  SALES_HISTORY
  COLLABORATION_SHEET
  ACTUAL_SALES
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IssueCode {
  SEGMENT_COUNT_MISMATCH
  MISSING_COLUMN
  INVALID_NUMBER
  INVALID_PERIOD
  UNKNOWN_ITEM
  ALIEN_ITEM
  STRUCTURE_CHANGED
}

model IngestionJob {
  id             String        @id @default(uuid()) @db.Uuid
  scenarioId     String        @db.Uuid
  kind           IngestionKind
  status         JobStatus     @default(PENDING)
  objectUri      String
  declaredLabels String[]
  totalRows      Int           @default(0)
  validRows      Int           @default(0)
  invalidRows    Int           @default(0)
  issueCount     Int           @default(0)
  issueCapReached Boolean      @default(false)
  uploadedById   String        @db.Uuid
  correlationId  String
  startedAt      DateTime?     @db.Timestamptz
  finishedAt     DateTime?     @db.Timestamptz
  failureReason  String?
  createdAt      DateTime      @default(now()) @db.Timestamptz

  scenario   Scenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation(fields: [uploadedById], references: [id])
  issues     IngestionIssue[]
  sales      SalesRecord[]
  actuals    ActualSalesRecord[]

  @@index([scenarioId, status])
  @@map("ingestion_jobs")
}

model IngestionIssue {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @db.Uuid
  lineNumber Int
  column     String?
  code       IssueCode
  detail     String

  job IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, lineNumber])
  @@map("ingestion_issues")
}

// ============================================================================
// Histórico e realizado
// ============================================================================

model SalesRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scenarioId  String   @db.Uuid
  productCode String
  segments    String[]
  year        Int
  month       Int
  quantity    Decimal  @db.Decimal(18, 6)
  sourceJobId String   @db.Uuid

  scenario  Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  sourceJob IngestionJob @relation(fields: [sourceJobId], references: [id])

  @@unique([scenarioId, productCode, segments, year, month])
  @@index([scenarioId, year, month])
  @@map("sales_records")
}

model ActualSalesRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scenarioId  String   @db.Uuid
  productCode String
  segments    String[]
  year        Int
  month       Int
  quantity    Decimal  @db.Decimal(18, 6)
  sourceJobId String   @db.Uuid

  scenario  Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  sourceJob IngestionJob @relation(fields: [sourceJobId], references: [id])

  @@unique([scenarioId, productCode, segments, year, month])
  @@index([scenarioId, year, month])
  @@map("actual_sales_records")
}

// ============================================================================
// Parametrização e cálculo
// ============================================================================

enum AccuracyMetric {
  WMAPE
  MAPE
  BIAS
}

enum ModelPackage {
  FAST
  STANDARD
  COMPLETE
}

model ForecastParameters {
  id               String         @id @default(uuid()) @db.Uuid
  scenarioId       String         @unique @db.Uuid
  groupingLevelIds String[]       @db.Uuid
  prorationMonths  Int
  accuracyMetric   AccuracyMetric @default(WMAPE)
  modelPackage     ModelPackage
  horizonMonths    Int            @default(12)
  updatedAt        DateTime       @updatedAt @db.Timestamptz

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@map("forecast_parameters")
}

model ForecastJob {
  id                  String    @id @default(uuid()) @db.Uuid
  scenarioId          String    @db.Uuid
  status              JobStatus @default(PENDING)
  parametersSnapshot  Json
  modelCatalogVersion String
  seriesCount         Int       @default(0)
  inputUri            String?
  outputUri           String?
  requestedById       String    @db.Uuid
  correlationId       String
  startedAt           DateTime? @db.Timestamptz
  finishedAt          DateTime? @db.Timestamptz
  failureReason       String?
  createdAt           DateTime  @default(now()) @db.Timestamptz

  scenario    Scenario                @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  requestedBy User                    @relation(fields: [requestedById], references: [id])
  items       ForecastItem[]
  series      ForecastSeriesResult[]

  // FR-051 — no máximo um job ativo por cenário. Índice PARCIAL, que o Prisma
  // não expressa: criado por SQL na migração.
  @@index([scenarioId, status])
  @@map("forecast_jobs")
}

model ForecastSeriesResult {
  id                  String  @id @default(uuid()) @db.Uuid
  jobId               String  @db.Uuid
  seriesKey           String
  winningModel        String
  evaluatedModels     Json
  metricValue         Decimal @db.Decimal(12, 6)
  otherMetrics        Json?
  fallbackApplied     Boolean @default(false)
  backtestWindowsUsed Int
  excludedModels      Json?

  job ForecastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seriesKey])
  @@map("forecast_series_results")
}

model ForecastItem {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String   @db.Uuid
  scenarioId          String   @db.Uuid
  productCode         String
  segments            String[]
  seriesKey           String
  year                Int
  month               Int
  calculatedQuantity  Decimal  @db.Decimal(18, 6)

  job         ForecastJob               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  adjustments CollaborationAdjustment[]
  decision    ConsensusDecision?
  published   PublishedForecast?

  @@unique([jobId, productCode, segments, year, month])
  @@index([scenarioId, year, month])
  @@index([jobId, seriesKey])
  @@map("forecast_items")
}

// ============================================================================
// Colaboração, consenso e publicação
// ============================================================================

enum AdjustmentOrigin {
  UI
  SPREADSHEET
}

enum ConsensusSource {
  CALCULATED
  COLLABORATED
  MANUAL
}

model CollaborationAdjustment {
  id             String           @id @default(uuid()) @db.Uuid
  scenarioId     String           @db.Uuid
  forecastItemId String           @db.Uuid
  authorId       String           @db.Uuid
  quantity       Decimal          @db.Decimal(18, 6)
  reason         String
  origin         AdjustmentOrigin
  supersededById String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz

  scenario     Scenario                 @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  forecastItem ForecastItem             @relation(fields: [forecastItemId], references: [id], onDelete: Cascade)
  author       User                     @relation(fields: [authorId], references: [id])
  supersededBy CollaborationAdjustment? @relation("AdjustmentChain", fields: [supersededById], references: [id])
  supersedes   CollaborationAdjustment[] @relation("AdjustmentChain")

  @@index([forecastItemId, createdAt])
  @@index([scenarioId, authorId])
  @@map("collaboration_adjustments")
}

model ConsensusDecision {
  id                   String          @id @default(uuid()) @db.Uuid
  forecastItemId       String          @unique @db.Uuid
  decidedById          String          @db.Uuid
  source               ConsensusSource
  quantity             Decimal         @db.Decimal(18, 6)
  reason               String?
  deltaToCalculated    Decimal         @db.Decimal(18, 6)
  deltaToCollaborated  Decimal?        @db.Decimal(18, 6)
  decidedAt            DateTime        @default(now()) @db.Timestamptz

  forecastItem ForecastItem @relation(fields: [forecastItemId], references: [id], onDelete: Cascade)
  decidedBy    User         @relation(fields: [decidedById], references: [id])

  @@map("consensus_decisions")
}

model PublishedForecast {
  id             String   @id @default(uuid()) @db.Uuid
  scenarioId     String   @db.Uuid
  forecastItemId String   @unique @db.Uuid
  quantity       Decimal  @db.Decimal(18, 6)
  publishedAt    DateTime @default(now()) @db.Timestamptz

  scenario     Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  forecastItem ForecastItem @relation(fields: [forecastItemId], references: [id])

  @@index([scenarioId])
  @@map("published_forecasts")
}

// ============================================================================
// Apuração
// ============================================================================

enum Coverage {
  BOTH
  FORECAST_ONLY
  ACTUAL_ONLY
}

model AccuracyRun {
  id                String         @id @default(uuid()) @db.Uuid
  scenarioId        String         @db.Uuid
  status            JobStatus      @default(PENDING)
  dimensionLevelIds String[]       @db.Uuid
  includeProduct    Boolean        @default(false)
  metric            AccuracyMetric
  periodYear        Int
  periodMonth       Int
  inputUri          String?
  outputUri         String?
  correlationId     String
  startedAt         DateTime?      @db.Timestamptz
  finishedAt        DateTime?      @db.Timestamptz
  failureReason     String?
  createdAt         DateTime       @default(now()) @db.Timestamptz

  scenario Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  results  AccuracyResult[]

  // SC-014: a combinação já apurada é leitura, não recálculo.
  @@unique([scenarioId, dimensionLevelIds, includeProduct, metric, periodYear, periodMonth], name: "accuracy_run_dimension")
  @@map("accuracy_runs")
}

model AccuracyResult {
  id                String   @id @default(uuid()) @db.Uuid
  runId             String   @db.Uuid
  dimensionKey      String
  publishedQuantity Decimal  @db.Decimal(18, 6)
  actualQuantity    Decimal  @db.Decimal(18, 6)
  metricValue       Decimal? @db.Decimal(12, 6)
  coverage          Coverage

  run AccuracyRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, dimensionKey])
  @@map("accuracy_results")
}

// ============================================================================
// Auditoria e notificação
// ============================================================================

enum AuditAction {
  PHASE_ADVANCED
  PARAMETERS_CHANGED
  FORECAST_PERSISTED
  ADJUSTMENT_MADE
  CONSENSUS_DECIDED
  PUBLISHED
  TEAM_CLOSED
  APPROVAL_GRANTED
  APPROVAL_RETURNED
}

enum AuditOrigin {
  UI
  SPREADSHEET
  INGESTION
  ENGINE
  SYSTEM
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  scenarioId    String      @db.Uuid
  entityType    String
  entityId      String      @db.Uuid
  action        AuditAction
  actorId       String?     @db.Uuid
  origin        AuditOrigin
  occurredAt    DateTime    @default(now()) @db.Timestamptz
  correlationId String
  payload       Json?

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([scenarioId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

enum EmailTemplate {
  FORECAST_READY
  PHASE_ADVANCED
  COLLABORATION_OPENED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailNotification {
  id                String        @id @default(uuid()) @db.Uuid
  scenarioId        String        @db.Uuid
  recipientEmail    String
  template          EmailTemplate
  status            EmailStatus   @default(PENDING)
  attempts          Int           @default(0)
  providerMessageId String?
  lastError         String?
  correlationId     String
  createdAt         DateTime      @default(now()) @db.Timestamptz
  sentAt            DateTime?     @db.Timestamptz

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, status])
  @@map("email_notifications")
}
