# =============================================================================
# SOP_APP — variáveis de ambiente por serviço
# Copie para .env e ajuste. NUNCA comite segredos reais.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=sop
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_DB=sop
POSTGRES_PORT=5432

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=sop
RABBITMQ_DEFAULT_PASS=troque-em-producao
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=sop
MINIO_ROOT_PASSWORD=troque-em-producao
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sop

# --- API (apps/api) -----------------------------------------------------------
API_PORT=3001
DATABASE_URL=postgresql://sop:troque-em-producao@postgres:5432/sop?schema=public
AMQP_URL=amqp://sop:troque-em-producao@rabbitmq:5672
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=sop
S3_SECRET_KEY=troque-em-producao
S3_BUCKET=sop
BETTER_AUTH_SECRET=gere-um-segredo-de-32-bytes
BETTER_AUTH_URL=http://localhost:3001
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
UPLOAD_MAX_BYTES=524288000
NODE_OPTIONS=--max-old-space-size=1536

# --- Worker de ingestão (apps/ingestion-worker) -------------------------------
INGESTION_PREFETCH=10
INGESTION_ISSUE_CAP=10000

# --- Worker de e-mail (apps/email-worker) -------------------------------------
RESEND_API_KEY=re_troque_pela_sua_chave
EMAIL_FROM=nao-responda@exemplo.com
EMAIL_MAX_ATTEMPTS=3

# --- Motor de cálculo (services/forecast-engine) ------------------------------
ENGINE_PREFETCH=1
ENGINE_METRICS_PORT=9102
NUMBA_CACHE_DIR=/app/.numba_cache
ENGINE_MAX_JOBS=4
MODEL_CATALOG_VERSION=2026.08

# --- Frontend (apps/web) ------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Observabilidade ----------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=troque-em-producao
LOKI_PORT=3100
